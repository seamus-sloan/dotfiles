[user]
	email = seamus.sloan@gmail.com
	name = seamus
[core]
	hooksPath = ~/.config/git/hooks
[push]
	autoSetupRemote = true
	default = simple
[diff]
	tool = meld
[difftool "vscode"]
        cmd = code --wait --diff $LOCAL $REMOTE	
[url "git@github.com:"]
	insteadOf = https://github.com/
[branch]
	autoSetupMerge = simple
