--- /dev/null
+++ b/home/dot_config/exact_nvim/lua/custom/plugins/workspaces_spec.lua
@@ -0,0 +1,83 @@
+-- Headless tests for workspaces.lua. Run from the repo root:
+--
+--   nvim --headless -l home/dot_config/exact_nvim/lua/custom/plugins/workspaces_spec.lua
+--
+-- Builds a throwaway HOME with a few fake repos, points the state file at a
+-- temp path, and exits non-zero when any check fails.
+
+-- This checkout's config goes first on 'runtimepath', ahead of the installed
+-- ~/.config/nvim, so `require` finds the module under test.
+local here = vim.fs.dirname(vim.fs.normalize(debug.getinfo(1, 'S').source:sub(2)))
+vim.opt.rtp:prepend(vim.fs.normalize(vim.fs.joinpath(here, '..', '..', '..')))
+
+-- Resolved, since `getcwd()` reports the real path (/private/var on macOS).
+local home = vim.fn.tempname()
+vim.fn.mkdir(home, 'p')
+home = vim.uv.fs_realpath(home)
+local state_path = vim.fs.joinpath(home, 'workspaces.json')
+vim.env.HOME = home
+vim.g.workspaces_state_path = state_path
+
+local function repo(name)
+  local path = vim.fs.joinpath(home, 'Repos', name)
+  vim.fn.mkdir(vim.fs.joinpath(path, '.git'), 'p')
+  return path
+end
+
+local alpha, beta, gamma = repo 'alpha', repo 'beta', repo 'gamma'
+
+local function write_state(state)
+  local f = assert(io.open(state_path, 'w'))
+  f:write(vim.json.encode(state))
+  f:close()
+end
+
+local function read_state()
+  local f = assert(io.open(state_path, 'r'))
+  local state = vim.json.decode(f:read '*a')
+  f:close()
+  return state
+end
+
+-- Saves are asynchronous; give the event loop a moment to land them.
+local function settle() vim.wait(200) end
+
+write_state { version = 1, recent = {}, tabs = {} }
+local workspaces = require 'custom.plugins.workspaces'
+
+local failures = 0
+local function check(name, ok, detail)
+  print((ok and 'ok   ' or 'FAIL ') .. name .. (ok and '' or ('  ' .. vim.inspect(detail))))
+  if not ok then failures = failures + 1 end
+end
+
+-- Recent projects come first, most recent at the top; the rest alphabetically.
+write_state { version = 1, recent = { gamma, alpha }, tabs = {} }
+local names = vim.tbl_map(function(p) return p.name end, workspaces.projects())
+check('recent projects first, then alphabetical', vim.deep_equal(names, { 'gamma', 'alpha', 'beta' }), names)
+
+-- The open repo tabs round-trip through the state file on quit.
+write_state { version = 1, recent = {}, tabs = {} }
+workspaces.open(alpha, { picker = false })
+workspaces.open(beta, { picker = false })
+settle()
+vim.api.nvim_exec_autocmds('VimLeavePre', {})
+settle()
+check('open tabs are saved on quit', vim.deep_equal(read_state().tabs, { alpha, beta }), read_state().tabs)
+
+-- :Workspace opens by exact or unique partial name.
+vim.cmd 'tabfirst'
+vim.cmd 'Workspace beta'
+check(':Workspace by exact name', vim.fn.getcwd(-1, 0) == beta, vim.fn.getcwd(-1, 0))
+vim.cmd 'tabfirst'
+vim.cmd 'Workspace gam'
+check(':Workspace by partial name', vim.fn.getcwd(-1, 0) == gamma, vim.fn.getcwd(-1, 0))
+
+-- The recent list is capped.
+for i = 1, 12 do
+  workspaces.open(repo(('p%02d'):format(i)), { picker = false })
+end
+settle()
+check('recent list holds at most 10', #read_state().recent <= 10, #read_state().recent)
+
+os.exit(failures)
