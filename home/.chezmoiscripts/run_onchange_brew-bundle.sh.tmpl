{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Re-runs whenever ~/.Brewfile changes (the hash below embeds its content into
# this script, which is what run_onchange keys on). macOS only; Arch gets its
# baseline from run_onchange_pacman-packages.sh.
# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}
set -e
command -v brew >/dev/null 2>&1 || { echo "brew missing; bootstrap first" >&2; exit 1; }
brew bundle --global
{{ end -}}
