# Shared baseline for every machine. `brew bundle --global` installs what's
# listed and never uninstalls extras, so each machine can layer additional
# packages on top freely — this file is the floor, not a mirror. Re-run
# automatically by chezmoi (.chezmoiscripts/run_onchange_brew-bundle.sh.tmpl)
# whenever this file changes.

tap "meta/fb"

# --- Core CLI ---
brew "chafa"
brew "chezmoi"
brew "cmake"
brew "direnv"
brew "docker-compose"
brew "ffmpeg"
brew "fzf"
brew "gh"
brew "gitleaks"
brew "go"
brew "imagemagick"
brew "mise"
brew "neovim"
brew "pipx"
brew "pkgconf"
brew "pre-commit"
brew "python@3.13"
brew "ripgrep"
brew "rtk"
brew "tree-sitter"
brew "tree-sitter-cli"
brew "unar"
brew "wget"
brew "worktrunk"
brew "zoxide"

# --- Mobile / device tools ---
brew "scrcpy"
brew "xcbeautify"
# Builds against full Xcode.app; skipped on machines with only the Command Line Tools.
brew "meta/fb/idb-companion", trusted: true if File.exist?("/Applications/Xcode.app")
cask "android-platform-tools"

# --- Apps ---
cask "bruno"
cask "codex"
cask "font-hack-nerd-font"
cask "hammerspoon"

# --- Rust tools ---
cargo "cargo-binstall"
cargo "cargo-generate"
cargo "create-tauri-app"
cargo "sqlx-cli"
cargo "worktrunk-sync"
cargo "workz"
cargo "zellij"

# --- Go tools ---
go "github.com/seamus-sloan/lazyffmpeg/cmd/lazyff"

# --- Node tools ---
npm "corepack"
npm "markdownlint-cli"
