          "name": "Opus 5 - Bedrock",
          "provider": {
            "api": "https://bedrock-runtime-fips.us-east-1.amazonaws.com"
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "low",
                "display": "summarized"
              }
            },
            "medium": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "medium",
                "display": "summarized"
              }
            },
            "high": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "high",
                "display": "summarized"
              }
            },
            "xhigh": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "xhigh",
                "display": "summarized"
              }
            },
            "max": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "max",
                "display": "summarized"
              }
            }
          },
          "attachment": true,
          "tool_call": true,
          "temperature": false,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "cost": {
            "input": 5,
            "output": 25,
            "cache_read": 0.5,
            "cache_write": 6.25
