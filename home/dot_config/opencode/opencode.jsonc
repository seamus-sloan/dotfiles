          }
        },
        "openai.gpt-5.6-luna": {
          "name": "GPT-5.6 Luna - Mantle",
          "provider": {
            "npm": "@ai-sdk/amazon-bedrock/mantle",
            "api": "https://bedrock-mantle.us-east-1.api.aws/openai/v1"
          },
          "headers": {
            "OpenAI-Project": "proj_se3pyqvs47n3dmauo2wh"
          }
        }
      }
    }
  },
  "model": "amazon-bedrock/anthropic.claude-opus-5",

  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    },
    "gmail": {
      "type": "remote",
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "enabled": true
    }
  },

  // Destructive-command guardrail — the opencode half of the `careful` skill.
  // Claude Code gets this from the ~/.claude/hooks/careful.sh PreToolUse hook;
  // opencode expresses the same intent natively, because a plugin cannot
  // escalate an already-allowed call back to "ask".
  //
  // Rules are evaluated with the LAST match winning, so the order below is
  // load-bearing: blanket allow, then the destructive patterns, then the
  // safe-list that pulls throwaway build directories back out of them.
  //
  // Patterns and rationale documented in ~/.claude/skills/careful/SKILL.md.
  // Keep this list and careful.sh in sync.
  "permission": {
    // Allows the builtin `workspace` tool to repoint this session at another
    // checkout of the same repo — the only reliable way to follow a worktree
    // created by `wt switch -c`, since a shell `cd` dies with its subprocess.
    "workspace": "allow",

    "bash": {
      "*": "allow",

      // Recursive deletes.
      "*rm -rf*": "ask",
      "*rm -fr*": "ask",
      "*rm -r *": "ask",
      "*rm -R *": "ask",
      "*rm --recursive*": "ask",

      // Destructive SQL. opencode's matcher is case-sensitive, so the two
      // casings people actually type both need a rule.
      "*DROP TABLE*": "ask",
      "*drop table*": "ask",
      "*DROP DATABASE*": "ask",
      "*drop database*": "ask",
      "*DROP SCHEMA*": "ask",
      "*drop schema*": "ask",
      "*TRUNCATE TABLE*": "ask",
      "*truncate table*": "ask",

      // History rewrites and working-tree discards.
      "*git push -f*": "ask",
      "*git push --force*": "ask",
      "*git reset --hard*": "ask",
      "*git checkout .*": "ask",
      "*git restore .*": "ask",

      // Infrastructure.
      "*kubectl delete*": "ask",
      "*docker rm -f*": "ask",
      "*docker system prune*": "ask",

      // jj is paused for the worktrunk trial, but the guard stays armed.
      "*jj abandon*": "ask",
      "*jj op restore*": "ask",

      // SAFE list — regenerable build output, no confirmation needed.
      "*rm -rf node_modules*": "allow",
      "*rm -rf dist*": "allow",
      "*rm -rf build*": "allow",
      "*rm -rf coverage*": "allow",
      "*rm -rf .next*": "allow",
      "*rm -rf .nuxt*": "allow",
      "*rm -rf .svelte-kit*": "allow",
      "*rm -rf .cache*": "allow",
      "*rm -rf .turbo*": "allow",
      "*rm -rf .parcel-cache*": "allow",
      "*rm -rf __pycache__*": "allow",
      "*rm -rf target/debug*": "allow",
      "*rm -rf target/release*": "allow"
    }
  }
}
