# Machine-local Claude Code permission grants inside the nvim tree; each
# machine keeps its own, the exact_nvim mirror must not delete or manage it.
.config/nvim/.claude

# opencode generates these next to its config — the plugin dependency manifest
# it feeds to `bun install`, that install's output, and a .gitignore covering
# both. Listed so `chezmoi add ~/.config/opencode` can't drag them in.
.config/opencode/.gitignore
.config/opencode/bun.lock
.config/opencode/node_modules
.config/opencode/package-lock.json
.config/opencode/package.json
