# Per-machine Claude Code grants the exact_nvim mirror must leave alone.
.config/nvim/.claude

# opencode's generated plugin install files, kept out of `chezmoi add`.
.config/opencode/.gitignore
.config/opencode/bun.lock
.config/opencode/node_modules
.config/opencode/package-lock.json
.config/opencode/package.json

# Machine-local: it holds prod AWS account details, and this repo is public.
.config/opencode/opencode.jsonc

# Written by `git lfs install`; exact_hooks would delete them and break LFS.
.config/git/hooks/post-checkout
.config/git/hooks/post-commit
.config/git/hooks/post-merge
.config/git/hooks/pre-push

# Synced by the desktop app; exact_skills would delete it on every apply.
.claude/skills/synced

# Linked in by Omarchy; exact_skills would delete it on every apply.
.claude/skills/diagnose-crash
.claude/skills/omarchy

# macOS only; Arch gets the same baseline from run_onchange_pacman-packages.sh.
{{ if ne .chezmoi.os "darwin" -}}
.Brewfile
{{ end -}}
